#include <windows.h>
#include "effect_editor_ids.h"

IDD_EFFECT_EDITOR DIALOGEX 0, 0, 451, 300
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dominion – Königreich-Effekte"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Effekt suchen", -1, 8, 9, 85, 10
    EDITTEXT IDC_QUERY, 8, 22, 123, 14, ES_AUTOHSCROLL
    COMBOBOX IDC_CATEGORY, 137, 22, 106, 78, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LISTBOX IDC_CATALOG, 8, 42, 235, 104, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT "Aktive Effekte (in Ausführungsreihenfolge)", -1, 251, 9, 192, 10
    LISTBOX IDC_ACTIVE, 251, 22, 192, 124, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Nach oben", IDC_UP, 251, 150, 60, 15
    PUSHBUTTON "Nach unten", IDC_DOWN, 315, 150, 61, 15
    PUSHBUTTON "Entfernen", IDC_REMOVE, 380, 150, 63, 15
    LTEXT "Wirkung", -1, 8, 151, 70, 10
    EDITTEXT IDC_DESCRIPTION, 8, 165, 435, 42, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "", IDC_EFFECT_EVIDENCE, 8, 212, 435, 22
    PUSHBUTTON "Ziel wählen…", IDC_TARGET, 8, 237, 123, 16
    PUSHBUTTON "Zweites Ziel wählen…", IDC_SECOND_TARGET, 137, 237, 123, 16
    PUSHBUTTON "Effekt hinzufügen", IDC_ADD, 352, 237, 91, 16
    AUTOCHECKBOX "Alle gezogenen Königreichstapel automatisch verdoppeln", IDC_AUTOMATIC, 8, 260, 276, 11
    RTEXT "", IDC_EFFECT_COUNT, 301, 260, 142, 11
    LTEXT "", IDC_STATUS, 8, 278, 286, 18
    DEFPUSHBUTTON "Übernehmen", IDOK, 303, 278, 66, 15
    PUSHBUTTON "Abbrechen", IDCANCEL, 377, 278, 66, 15
END

IDD_CARD_PICKER DIALOGEX 0, 0, 414, 318
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ziele wählen"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Karten suchen", -1, 8, 9, 120, 10
    EDITTEXT IDC_CARD_QUERY, 8, 22, 207, 15, ES_AUTOHSCROLL
    COMBOBOX IDC_CARD_SCOPE, 8, 43, 207, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL "", IDC_CARD_TREE, "SysTreeView32", WS_BORDER | WS_TABSTOP | 0x27, 8, 64, 207, 164
    PUSHBUTTON "Alle angezeigten auswählen", IDC_CARD_ALL, 8, 234, 138, 15
    AUTOCHECKBOX "Weitere Kopie hinzufügen", IDC_CARD_REPEAT, 8, 253, 207, 12
    LTEXT "", IDC_CARD_HINT, 8, 270, 207, 21
    LISTBOX IDC_CARD_SELECTION, 8, 234, 162, 58, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Hoch", IDC_CARD_UP, 176, 234, 39, 15
    PUSHBUTTON "Runter", IDC_CARD_DOWN, 176, 252, 39, 15
    PUSHBUTTON "Entfernen", IDC_CARD_REMOVE, 176, 270, 39, 15
    LTEXT "Kartenvorschau", IDC_CARD_TITLE, 223, 9, 183, 12
    LTEXT "", IDC_CARD_INFO, 223, 24, 183, 32
    CONTROL "", IDC_CARD_IMAGE, "Static", SS_OWNERDRAW, 223, 62, 183, 111
    EDITTEXT IDC_CARD_RULES, 223, 179, 183, 113, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "", IDC_CARD_STATUS, 8, 298, 235, 18
    DEFPUSHBUTTON "Auswahl übernehmen", IDOK, 246, 298, 91, 15
    PUSHBUTTON "Abbrechen", IDCANCEL, 343, 298, 63, 15
END
