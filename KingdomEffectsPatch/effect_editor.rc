#include <windows.h>
#include "effect_editor_ids.h"

IDD_EFFECT_EDITOR DIALOGEX 0, 0, 451, 324
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dominion – Königreich-Effekte"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Effekt suchen", -1, 8, 9, 85, 10
    EDITTEXT IDC_QUERY, 8, 22, 123, 14, ES_AUTOHSCROLL
    COMBOBOX IDC_CATEGORY, 137, 22, 106, 78, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LISTBOX IDC_CATALOG, 8, 42, 235, 104, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT "Aktive Effekte (in Ausführungsreihenfolge)", -1, 251, 9, 192, 10
    LISTBOX IDC_ACTIVE, 251, 22, 192, 124, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Nach oben", IDC_UP, 251, 150, 60, 15
    PUSHBUTTON "Nach unten", IDC_DOWN, 315, 150, 61, 15
    PUSHBUTTON "Entfernen", IDC_REMOVE, 380, 150, 63, 15
    LTEXT "Wirkung", -1, 8, 151, 70, 10
    EDITTEXT IDC_DESCRIPTION, 8, 167, 435, 48, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Ziel", IDC_TARGET_LABEL, 8, 220, 205, 9
    LTEXT "Zweites Ziel", IDC_SECOND_LABEL, 236, 220, 207, 9
    COMBOBOX IDC_TARGET, 8, 232, 220, 123, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_SECOND_TARGET, 236, 232, 207, 123, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Ziel vormerken", IDC_MULTI_ADD, 8, 251, 70, 15
    LISTBOX IDC_MULTI_TARGETS, 84, 251, 161, 29, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Ziel entfernen", IDC_MULTI_REMOVE, 251, 251, 72, 15
    PUSHBUTTON "Effekt hinzufügen", IDC_ADD, 352, 251, 91, 15
    AUTOCHECKBOX "Alle gezogenen Königreichstapel automatisch verdoppeln", IDC_AUTOMATIC, 8, 285, 300, 11
    LTEXT "", IDC_STATUS, 8, 303, 286, 13
    DEFPUSHBUTTON "Übernehmen", IDOK, 303, 302, 66, 15
    PUSHBUTTON "Abbrechen", IDCANCEL, 377, 302, 66, 15
END
