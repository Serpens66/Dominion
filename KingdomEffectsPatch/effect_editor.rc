#include <windows.h>
#include <commctrl.h>
#include "effect_editor_ids.h"

IDD_EFFECT_EDITOR DIALOGEX 0, 0, 570, 347
STYLE DS_SETFONT | WS_POPUP
CAPTION "Königreich"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Kampagnen-Features", IDC_EFFECT_LABEL, 8, 29, 230, 11
    EDITTEXT IDC_QUERY, 8, 42, 254, 14, ES_AUTOHSCROLL
    COMBOBOX IDC_CATEGORY, 266, 42, 131, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_CATALOG_HEADER, "Static", SS_OWNERDRAW, 8, 61, 389, 15
    CONTROL "", IDC_CATALOG, "DominionEffectTable", WS_BORDER | WS_VSCROLL | WS_TABSTOP | WS_CLIPCHILDREN | LBS_HASSTRINGS | LBS_OWNERDRAWVARIABLE, 8, 76, 389, 175
    LTEXT "Teststand", -1, 8, 255, 100, 10
    EDITTEXT IDC_EFFECT_EVIDENCE, 8, 268, 389, 26, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "Karte wählen…", IDC_TARGET, 8, 298, 127, 16
    PUSHBUTTON "Zweites Ziel…", IDC_SECOND_TARGET, 139, 298, 127, 16
    PUSHBUTTON "Effekt hinzufügen", IDC_ADD, 270, 298, 127, 16
    LTEXT "Aktive Effekte", IDC_ACTIVE_LABEL, 405, 29, 157, 11
    LISTBOX IDC_ACTIVE, 405, 42, 157, 252, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON "Entfernen", IDC_REMOVE, 405, 298, 157, 16
    LTEXT "", IDC_STATUS, 8, 316, 554, 12
    AUTOCHECKBOX "Alle gezogenen Stapel verdoppeln", IDC_AUTOMATIC, 8, 329, 229, 15
    LTEXT "Language:", IDC_LANGUAGE_LABEL, 238, 332, 35, 10
    COMBOBOX IDC_LANGUAGE, 274, 329, 62, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    RTEXT "", IDC_EFFECT_COUNT, 337, 332, 60, 10
    DEFPUSHBUTTON "Fertig", IDOK, 405, 329, 76, 16
    PUSHBUTTON "Abbrechen", IDCANCEL, 485, 329, 77, 16
END

IDD_CARD_PICKER DIALOGEX 0, 0, 386, 386
STYLE DS_SETFONT | WS_POPUP
CAPTION "Karte wählen"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Erweiterungen", IDC_CARD_EXPANSIONS, 8, 29, 205, 10
    EDITTEXT IDC_CARD_QUERY, 8, 42, 101, 14, ES_AUTOHSCROLL
    COMBOBOX IDC_CARD_SCOPE, 113, 42, 97, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL "", IDC_CARD_TREE, "SysTreeView32", WS_BORDER | WS_TABSTOP | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS, 8, 59, 202, 302
    PUSHBUTTON "Alle angezeigten auswählen", IDC_CARD_ALL, 8, 191, 98, 14
    AUTOCHECKBOX "Weitere Kopie hinzufügen", IDC_CARD_REPEAT, 91, 191, 119, 14
    LTEXT "", IDC_CARD_HINT, 8, 208, 202, 15
    LISTBOX IDC_CARD_SELECTION, 8, 170, 149, 52, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Stapel hinzufügen", IDC_CARD_ADD, 8, 170, 149, 16
    PUSHBUTTON "Entfernen", IDC_CARD_REMOVE, 161, 207, 49, 15
    LTEXT "", IDC_CARD_TITLE, 217, 29, 161, 19
    CONTROL "", IDC_CARD_INFO, "Static", SS_OWNERDRAW, 217, 48, 161, 34
    CONTROL "", IDC_CARD_IMAGE, "Static", SS_OWNERDRAW, 217, 129, 161, 232
    EDITTEXT IDC_CARD_RULES, 217, 154, 161, 68, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "", IDC_CARD_STATUS, 8, 226, 256, 17
    DEFPUSHBUTTON "Fertig", IDOK, 271, 227, 52, 16
    PUSHBUTTON "Abbrechen", IDCANCEL, 326, 227, 52, 16
END
