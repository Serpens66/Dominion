#include <windows.h>
#include <commctrl.h>
#include "effect_editor_ids.h"

IDD_EFFECT_EDITOR DIALOGEX 0, 0, 400, 244
STYLE DS_SETFONT | WS_POPUP
CAPTION "Königreich"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Kampagnen-Features", IDC_EFFECT_LABEL, 8, 29, 111, 11
    EDITTEXT IDC_QUERY, 8, 42, 108, 14, ES_AUTOHSCROLL
    COMBOBOX IDC_CATEGORY, 121, 42, 98, 78, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LISTBOX IDC_CATALOG, 8, 60, 211, 67, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    EDITTEXT IDC_DESCRIPTION, 8, 131, 211, 30, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    EDITTEXT IDC_EFFECT_EVIDENCE, 8, 164, 211, 21, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "Karte wählen…", IDC_TARGET, 8, 189, 69, 15
    PUSHBUTTON "Zweites Ziel…", IDC_SECOND_TARGET, 80, 189, 57, 15
    PUSHBUTTON "Effekt hinzufügen", IDC_ADD, 140, 189, 79, 15
    LTEXT "Aktive Effekte", IDC_ACTIVE_LABEL, 227, 29, 165, 11
    LISTBOX IDC_ACTIVE, 227, 42, 165, 143, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON "Nach oben", IDC_UP, 227, 189, 52, 15
    PUSHBUTTON "Nach unten", IDC_DOWN, 282, 189, 54, 15
    PUSHBUTTON "Entfernen", IDC_REMOVE, 339, 189, 53, 15
    LTEXT "", IDC_STATUS, 8, 207, 384, 19
    AUTOCHECKBOX "Alle gezogenen Stapel verdoppeln", IDC_AUTOMATIC, 8, 225, 210, 15
    RTEXT "", IDC_EFFECT_COUNT, 222, 227, 56, 10
    DEFPUSHBUTTON "Fertig", IDOK, 283, 224, 53, 16
    PUSHBUTTON "Abbrechen", IDCANCEL, 339, 224, 53, 16
END

IDD_CARD_PICKER DIALOGEX 0, 0, 386, 247
STYLE DS_SETFONT | WS_POPUP
CAPTION "Karte wählen"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Erweiterungen", IDC_CARD_EXPANSIONS, 8, 29, 205, 10
    EDITTEXT IDC_CARD_QUERY, 8, 42, 101, 14, ES_AUTOHSCROLL
    COMBOBOX IDC_CARD_SCOPE, 113, 42, 97, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL "", IDC_CARD_TREE, "SysTreeView32", WS_BORDER | WS_TABSTOP | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS, 8, 59, 202, 163
    PUSHBUTTON "Alle angezeigten auswählen", IDC_CARD_ALL, 8, 191, 98, 14
    AUTOCHECKBOX "Weitere Kopie hinzufügen", IDC_CARD_REPEAT, 91, 191, 119, 14
    LTEXT "", IDC_CARD_HINT, 8, 208, 202, 15
    LISTBOX IDC_CARD_SELECTION, 8, 170, 149, 52, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Hoch", IDC_CARD_UP, 161, 170, 49, 15
    PUSHBUTTON "Runter", IDC_CARD_DOWN, 161, 188, 49, 15
    PUSHBUTTON "Entfernen", IDC_CARD_REMOVE, 161, 207, 49, 15
    LTEXT "", IDC_CARD_TITLE, 217, 29, 161, 19
    CONTROL "", IDC_CARD_INFO, "Static", SS_OWNERDRAW, 217, 48, 161, 34
    CONTROL "", IDC_CARD_IMAGE, "Static", SS_OWNERDRAW, 217, 84, 161, 67
    EDITTEXT IDC_CARD_RULES, 217, 154, 161, 68, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "", IDC_CARD_STATUS, 8, 226, 256, 17
    DEFPUSHBUTTON "Fertig", IDOK, 271, 227, 52, 16
    PUSHBUTTON "Abbrechen", IDCANCEL, 326, 227, 52, 16
END
